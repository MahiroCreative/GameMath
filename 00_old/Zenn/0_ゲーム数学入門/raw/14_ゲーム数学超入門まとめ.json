                                         "level":  2,
                                         "children":  [
                                                          {
                                                              "id":  "%E7%B4%AF%E4%B9%97%E6%A0%B9%E3%81%AE%E8%A8%88%E7%AE%97",
                                                              "text":  "累乗根の計算",
                                                              "level":  3,
                                                              "children":  ""
                                                          }
