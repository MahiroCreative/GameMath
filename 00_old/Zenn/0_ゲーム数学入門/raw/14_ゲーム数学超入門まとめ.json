                                     },
                                     {
                                         "id":  "%E7%82%B9%E3%81%A8%E5%BA%A7%E6%A8%99",
                                         "text":  "点と座標",
                                         "level":  2,
                                         "children":  [
                                                          {
                                                              "id":  "%E4%B8%AD%E7%82%B9%E3%81%AE%E5%BA%A7%E6%A8%99",
                                                              "text":  "中点の座標",
                                                              "level":  3,
                                                              "children":  ""
                                                          },
                                                          {
                                                              "id":  "n%E7%82%B9%E9%96%93%E3%81%AE%E4%B8%AD%E7%82%B9",
                                                              "text":  "n点間の中点",
                                                              "level":  3,
                                                              "children":  ""
