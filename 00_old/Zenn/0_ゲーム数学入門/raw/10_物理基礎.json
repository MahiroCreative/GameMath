                                         "id":  "%E6%AC%A1%E5%85%83(%EF%BE%83%EF%BE%9E%EF%BD%A8%EF%BE%92%EF%BE%9D%EF%BD%BC%EF%BD%AE%EF%BE%9D)",
                                         "text":  "次元(ﾃﾞｨﾒﾝｼｮﾝ)",
                                         "level":  3,
                                         "children":  [

                                                      ]
